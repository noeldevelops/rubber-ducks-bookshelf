---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="vote for the books to read next in Rubber Ducks Book Club"
		/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,200..1000;1,200..1000&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="wrapper">
		<header class="full-bleed">
			<h1>2025 Voting Ballot - Rubber Ducks Book Club</h1>
		</header>
		<main><slot /></main>
	</body>
	<svg style="display: none;">
		<symbol id="star" viewBox="0 0 1024 1024"
			><polygon
				points="512 0 627 354 999 354 698 572 813 926 512 708 211 926 326 572 25 354 397 354 512 0"
			></polygon></symbol
		>
	</svg>
</html>
<style is:global>
	:root {
		--background: #00473e;
		--contrast: #fffffe;
		--light-bkgd: #fdfefd;
		--light-frgd: #2c3d3b;
		--headline: #034e40;
		--dark-headline: #fffffe;
		--highlight: #facc13;
		--secondary: #8549a7;
		--tertiary: #040303;
		--error: #ff005c;
	}
	* {
		box-sizing: border-box;
	}
	html {
		font-family: "Mulish", system-ui, sans-serif;
		color: var(--contrast);
		background: var(--background);
		font-optical-sizing: auto;
		font-weight: 400;
		font-style: normal;
	}
	body {
		width: 100%;
		height: 100%;
		overflow-x: hidden;
		margin: 0;
	}
	.wrapper {
		display: grid;
		grid-template-columns:
			1fr
			20fr
			1fr;
	}

	.wrapper > * {
		grid-column: 2;
	}

	.full-bleed {
		width: 100%;
		grid-column: 1 / 4;
	}
	main {
		margin-top: 2rem;
	}
	header {
		color: var(--light-frgd);
		background: var(--light-bkgd);
		margin: 0;
		width: 100%;
		position: sticky;
		top: 0;
		box-shadow: 0 0 3px 1px var(--background);
		padding: 5px 10px;
		z-index: 2;
	}

	header h1 {
		color: var(--headline);
		margin-bottom: 0.5rem;
		text-wrap: balance;
		line-height: 1;
	}
	header a {
		color: var(--headline);
	}
	.mulish-bold {
		font-family: "Mulish", serif;
		font-optical-sizing: auto;
		font-weight: 700;
		font-style: normal;
	}
</style>
