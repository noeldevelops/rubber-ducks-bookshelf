---
import Layout from "../layouts/Layout.astro";
import List from "../components/Form.astro";
import { getAllBooks } from "../utils/googleSheets";

const recommendedBooks = await getAllBooks();
---

<Layout title="Rubber Ducks Book Club">
  <h1>Voting is done! Form is no longer accepting submissions.</h1>
  {
    recommendedBooks.length > 0 ? (
      <List books={recommendedBooks} />
    ) : (
      <p>Error: No books found.</p>
    )
  }
</Layout>
