---
import RatingFieldset from "./RatingFieldset.astro";

import type { Book } from "../utils/googleSheets";

interface Props {
	book: Book;
}

const { book } = Astro.props;
---

<li class="link-card">
	<span class="tag">{book.categories}</span>
	<div>
		<a class="mulish-bold" href={book.googleBooksUrl} target="_blank">
			{book.title}
			<span class="icon"
				><svg
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					><path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M20 14a1 1 0 0 0-1 1v3.077c0 .459-.022.57-.082.684a.363.363 0 0 1-.157.157c-.113.06-.225.082-.684.082H5.923c-.459 0-.571-.022-.684-.082a.363.363 0 0 1-.157-.157c-.06-.113-.082-.225-.082-.684L4.999 5.5a.5.5 0 0 1 .5-.5l3.5.005a1 1 0 1 0 .002-2L5.501 3a2.5 2.5 0 0 0-2.502 2.5v12.577c0 .76.083 1.185.32 1.627.223.419.558.753.977.977.442.237.866.319 1.627.319h12.154c.76 0 1.185-.082 1.627-.319.419-.224.753-.558.977-.977.237-.442.319-.866.319-1.627V15a1 1 0 0 0-1-1zm-2-9.055v-.291l-.39.09A10 10 0 0 1 15.36 5H14a1 1 0 1 1 0-2l5.5.003a1.5 1.5 0 0 1 1.5 1.5V10a1 1 0 1 1-2 0V8.639c0-.757.086-1.511.256-2.249l.09-.39h-.295a10 10 0 0 1-1.411 1.775l-5.933 5.932a1 1 0 0 1-1.414-1.414l5.944-5.944A10 10 0 0 1 18 4.945z"
						fill="currentColor"></path></svg
				></span
			>
			{
				book.subtitle ? (
					<span class="subtitle">{book.subtitle || ""}</span>
				) : null
			}
		</a>
		<p>
			by {book.author}, {book.pubDate?.split("-")[0]}
		</p>
	</div>
	<details>
		<summary class="mulish-bold">Description</summary>
		<div class="description-content">
			{book.description}
		</div>
	</details>
	<RatingFieldset
		name={`${book.title.toLowerCase().replace(/\s+/g, "-").substring(0, 10)}`}
	/>
</li>
<style>
	.link-card {
		flex: 1 1 250px;
		max-width: 400px;
		list-style: none;
		display: flex;
		flex-direction: column;
		justify-content: space-evenly;
		gap: 10px;
		padding: 10px;
		background-color: var(--light-bkgd);
		color: var(--light-frgd);
		border-radius: 7px;
	}
	.link-card > div:first-child {
		display: flex;
		flex-direction: column;
		gap: 0;
	}
	.link-card a {
		font-size: large;
		text-decoration: none;
		color: var(--headline);
		transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.link-card a:hover,
	.link-card a:focus-within {
		color: var(--secondary);
	}
	.subtitle {
		display: inline-block;
		font-size: 0.9em;
	}
	.tag {
		display: inline;
		max-width: fit-content;
		font-size: 0.8em;
		padding: 3px;
		border-radius: 3px;
		border: 1px solid var(--light-frgd);
		color: var(--light-frgd);
	}
	p,
	summary {
		margin-top: 0;
		margin-bottom: 0;
		font-size: 0.9em;
	}
	details {
		padding: 3px;
		margin-top: 5px;
	}
	.description-content {
		z-index: 9;
		font-size: small;
		max-height: 200px;
		overflow-y: auto;
		padding-right: 10px;
		padding: 5px 10px 5px 5px;
		border: 1px solid var(--light-frgd);
	}
</style>
