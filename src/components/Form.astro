---
import Card from "./Card.astro";
import type { Book } from "../utils/googleSheets";

interface Props {
  books: Book[];
}

const { books } = Astro.props;
---

<button id="scroll-top" aria-label="Scroll to top" title="Scroll to top"
  ><svg
    height="20px"
    width="20px"
    version="1.1"
    id="Capa_1"
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    viewBox="0 0 244.007 244.007"
    xml:space="preserve"
  >
    <g>
      <path
        style="fill:currentColor"
        d="M111.01,231.071c2.219,17.139,29.442,17.356,27.195,0c-4.623-35.675-4.302-71.545-4.128-107.432
   c23.154,0.566,46.319,1.055,69.397-1.349c6.826-0.713,14.321-5.668,13.598-13.598c-4.444-48.826-61.38-63.882-83.446-102.048
   c-4.417-7.636-15.137-8.877-21.354-2.752C82.015,33.72,58.387,69.537,32.079,102.731c-6.592,3.954-6.5,12.972-2.012,18.977
   c3.617,5.575,10.41,8.692,16.268,5.167c20.092-3.285,40.298-3.927,60.548-3.758C106.708,159.178,106.365,195.228,111.01,231.071z
    M70.299,97.254c16.1-21.408,32.042-43.012,50.154-62.674c7.441,8.561,16.138,16.013,24.873,23.399
   c11.694,9.883,31.857,22.888,40.499,38.449C147.294,98.467,108.742,94.953,70.299,97.254z"
      ></path>
    </g>
  </svg></button
>
<form id="all-books" name="2025-votes" method="POST" data-netlify="true">
  <div>
    <label for="name">Name or Rubber Ducks Slack Handle:</label>
    <input disabled type="text" id="name" name="name" required minlength="2" />
    <p class="help">
      Only to prevent spam and duplicated submissions. How you vote will remain
      anonymous. :)
    </p>
  </div>
  <div>
    <!-- For debugging/testing
      <button class="btn" type="button" id="auto-fill"
      >Auto-fill with 4 stars ("meh")</button
    > -->
  </div>
  <div>
    <p class="description mulish-bold">
      Rate each book based on how much you want to read it this year:
    </p>
    <div class="books-container">
      {books.map((book) => <Card {book} />)}
    </div>
  </div>
  <button
    disabled
    class="btn"
    id="submit-btn"
    type="submit"
    title="Save choices">Submit Vote</button
  >
</form>
<script>
  const scrollButton = document.getElementById("scroll-top");

  window.addEventListener("scroll", () => {
    const scrollPercentage =
      window.scrollY /
      (document.documentElement.scrollHeight - window.innerHeight);

    if (scrollPercentage > 0.3) {
      scrollButton?.style.setProperty("display", "block");
    } else {
      scrollButton?.style.setProperty("display", "none");
    }
  });

  scrollButton?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  });
  document.querySelector("#all-books")?.addEventListener("submit", (e) => {
    e.preventDefault();

    const formData = new FormData(e.target as HTMLFormElement);
    const data = Object.fromEntries(formData);

    console.log("Form submission data:", data);

    // Allow the form to submit normally after logging
    (e.target as HTMLFormElement).submit();
  });
  document.querySelector("#auto-fill")?.addEventListener("click", () => {
    // Get all radio groups by finding all radio inputs and grouping by name
    const radioGroups = document.querySelectorAll('input[type="radio"]');
    const groupNames = new Set(
      [...radioGroups].map((radio) => radio.getAttribute("name"))
    );

    // For each radio group name
    groupNames.forEach((name) => {
      // Find if any radio in this group is checked
      const isGroupEmpty = ![...radioGroups]
        .filter((radio) => radio.getAttribute("name") === name)
        .some((radio) => (radio as HTMLInputElement).checked);

      // If none are checked, select the "meh" (value 4) option
      if (isGroupEmpty) {
        const mehRadio = document.querySelector(
          `input[type="radio"][name="${name}"][value="4"]`
        );
        if (mehRadio) {
          (mehRadio as HTMLInputElement).checked = true;
        }
      }
    });
  });
</script>

<style>
  form {
    padding-bottom: 2rem;
  }
  .books-container {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    overflow-y: auto;
    padding-bottom: 1rem;
    padding-top: 0;
  }
  .description {
    color: var(--contrast);
  }

  .help {
    font-size: small;
    margin-top: 0;
  }
  input[type="text"] {
    padding: 5px;
    width: 250px;
    font-size: 16px;
    border: 1px solid transparent;
  }
  input[type="text"]:invalid {
    border-color: var(--error);
  }
  form:invalid .btn[type="submit"] {
    cursor: not-allowed;
    opacity: 0.5;
  }
  .btn {
    padding: 20px;
    width: 100%;
    max-width: 200px;
    box-shadow: none;
    border: none;
    border-radius: 5px;
    background-color: var(--error);
    color: var(--contrast);
    font-weight: bold;
    font-size: large;
  }

  .btn:hover {
    background-color: var(--secondary);
  }
  form:invalid .btn:hover {
    background-color: var(--error);
  }
  #scroll-top {
    display: none;
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: var(--highlight);
    color: var(--headline);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.3s;
    z-index: 99;
  }

  #scroll-top:hover {
    opacity: 1;
  }
</style>
