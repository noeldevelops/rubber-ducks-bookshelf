---
import Star from "./Star.astro";

interface Props {
    name: string;
}

// Name is a shortened version of book title
const { name } = Astro.props;
---

<fieldset name={name}>
    <legend class="label"
        >On a scale of 1 to 7 how much do you want to read this?</legend
    >
    <div class="inputs">
        <Star name={name} value="7" />
        <Star name={name} value="6" />
        <Star name={name} value="5" />
        <Star name={name} value="4" />
        <Star name={name} value="3" />
        <Star name={name} value="2" />
        <Star name={name} value="1" />
    </div>
    <div class="hints">
        <p>Would NOT read</p>
        <p>Meh</p>
        <p>Would LOVE TO read</p>
    </div>
</fieldset>

<style>
    fieldset {
        margin-top: auto;
        border: 1px solid var(--light-frgd);
    }
    fieldset:invalid {
        border-color: var(--error);
    }
    legend {
        font-size: 13px;
    }

    .inputs {
        display: flex;
        flex-direction: row-reverse;
        justify-content: space-between;
    }
    .hints {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }
    .hints > p {
        font-size: 11px;
        font-weight: 700;
        display: inline;
        max-width: 28px;
    }
    .hints > p:last-child() {
        text-align: right;
        white-space: break;
    }
</style>
